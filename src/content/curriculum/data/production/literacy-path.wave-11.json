  "meta": {
    "kind": "production",
    "id": "hurufi.production.literacy.wave11",
    "title": "Literacy path — Wave 11",
    "description": "Eleventh production literacy slice: madd-alif TRANSFER from ba to jim. Compact two-unit wave. Score initial jim, transfer madd onto jaa, then decode dajaj. No new consonant. No new madd rule. Function-word laa is postponed. No hamza, kasra, damma, long waw/ya, or Wave 12.",
    "notProductionCurriculum": false
  },
