  "meta": {
    "kind": "production",
    "id": "hurufi.production.literacy.wave7",
    "title": "Literacy path — Wave 7",
    "description": "Seventh production literacy slice: letter س on the established SHOW → PRACTICE → TEST pattern. Compact two-unit wave. Reuses fatha only. سَمَك is the single new Band A word. Final ك form is prepared because Wave 5 scored only initial ك. No ش, ع, ن, ه, خ, ط, madd, kasra, damma, hamza, or Wave 8.",
    "notProductionCurriculum": false
  },
